# ============================================
# fuli 项目环境变量配置
# 复制此文件为 .env 并修改为自己的配置
# ============================================

# JWT 签名密钥（生产环境至少 32 字节，推荐 64 字节随机字符串）
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=123456

# 内部接口调用密钥（用于 /auth/internal/** 接口鉴权）
INTERNAL_KEY=your-internal-key-here-change-me

# Tushare Token（可选，未配置时数据同步功能不可用但不影响其他功能）
TUSHARE_TOKEN=

# Redis 配置（可选，默认本地）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Nacos 配置（可选，不启动不影响本地开发）
NACOS_SERVER=127.0.0.1:8848
