# ============================================
# fuli 项目环境变量配置
# 复制此文件为 .env 并修改为自己的配置
#
# 本地开发：各服务激活 local profile（spring.profiles.active=local），
#           使用 application-local.yml 中的开发密钥，无需配置下列密钥。
# 生产环境：必须通过下列环境变量注入强密钥，禁止依赖默认值。
# ============================================

# JWT 签名密钥（生产环境必须 >= 32 字节，推荐 64 字节随机字符串）
# 生成示例：openssl rand -base64 64
JWT_SECRET=replace-with-64-byte-random-secret-generated-by-openssl-rand-base64-64

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=123456

# 内部接口调用密钥（用于 /auth/internal/** 接口鉴权，生产环境必须 >= 16 字节）
# 生成示例：openssl rand -base64 24
INTERNAL_KEY=replace-with-24-byte-random-internal-key-generated-by-openssl-rand-base64-24

# Tushare Token（可选，未配置时数据同步功能不可用但不影响其他功能）
TUSHARE_TOKEN=

# Redis 配置（可选，默认本地）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Nacos 配置（可选，不启动不影响本地开发）
NACOS_SERVER=127.0.0.1:8848
